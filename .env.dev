# Development Environment Variables for Billing Service
# This file is used when running: docker compose -f docker-compose.dev.yml up

# Django Environment
DJANGO_ENV=dev
DJANGO_SETTINGS_MODULE=billing_service.settings.dev

# Security
SECRET_KEY=django-insecure-billing-service-dev-key-change-in-production
DEBUG=True

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,*

# Database Configuration
# This connects to the postgres service defined in docker-compose.dev.yml
DATABASE_URL=postgresql://devuser:devpass@db:5432/billing_devdb

# Database SSL (not required for local dev)
REQUIRE_DB_SSL=false

# Pesaway Payment Gateway Configuration (Development/Test Mode)
PESAWAY_API_KEY=your_pesaway_api_key_here
PESAWAY_SECRET_KEY=your_pesaway_secret_key_here
PESAWAY_MERCHANT_ID=your_pesaway_merchant_id_here
PESAWAY_TEST_MODE=true
PESAWAY_WEBHOOK_URL=http://localhost:8002/api/billing/webhooks/pesaway/
PESAWAY_WEBHOOK_SECRET=your_webhook_secret_here

# Port (optional, defaults to 8000)
PORT=8000

# Workers (optional, defaults to 2)
WORKERS=2
