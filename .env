# Production Environment Variables for Billing Service
# This file is used when running: docker compose up
#  IMPORTANT: Replace all placeholder values with actual production credentials

# Django Environment
DJANGO_SETTINGS_MODULE=billing_service.settings.prod

# Security
#  CRITICAL: Generate a strong secret key for production
# You can generate one using: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_KEY_IN_PRODUCTION
DEBUG=False

# Allowed Hosts (comma-separated)
#  Update with your actual production domain
ALLOWED_HOSTS=api.quidpath.com,quidpath.com,www.quidpath.com,billing.quidpath.com

# CSRF Trusted Origins (comma-separated, include scheme)
#  Update with your actual production domains
CSRF_TRUSTED_ORIGINS=https://quidpath.com,https://www.quidpath.com,https://*.quidpath.com

# Database Configuration
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
#  Replace with your actual production database credentials
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# PostgreSQL Database Credentials (used by docker-compose.yml)
#  Replace with strong production credentials
POSTGRES_DB=billing_prod
POSTGRES_USER=billing_user
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD

# Database SSL (recommended for production)
REQUIRE_DB_SSL=true

# Shared authentication DB (main backend)
AUTH_POSTGRES_DB=quidpath_db
AUTH_POSTGRES_USER=quidpath_user
AUTH_POSTGRES_PASSWORD=eDgDiAcayFqcPpXjThL6Ak668
AUTH_POSTGRES_HOST=postgres_prod

# Pesaway Payment Gateway Configuration (Production Mode)
#  Replace with your actual production Pesaway credentials
PESAWAY_API_KEY=your_production_pesaway_api_key
PESAWAY_SECRET_KEY=your_production_pesaway_secret_key
PESAWAY_MERCHANT_ID=your_production_pesaway_merchant_id
PESAWAY_TEST_MODE=false
PESAWAY_WEBHOOK_URL=https://billing.quidpath.com/api/billing/webhooks/pesaway/
PESAWAY_WEBHOOK_SECRET=your_production_webhook_secret

# Server Configuration
PORT=8000
WORKERS=4

# Optional: Email Configuration (if needed)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
